{
  "name": "narsil-workshop",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .husky",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "secretlint": "secretlint \"**/*\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "lighthouse": "lhci autorun",
    "audit:check": "pnpm audit --audit-level=high",
    "precommit": "lint-staged",
    "check": "pnpm run format:check && pnpm run lint:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@astrojs/sitemap": "^3.7.5",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "astro": "^7.4.12",
    "eslint": "^10.15.0",
    "eslint-config-love": "^158.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^21.0.4",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "secretlint": "^13.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "unrs-resolver": "1.13.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "astro-icon": "^1.2.0"
  }
}
