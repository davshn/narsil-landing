#!/bin/sh
set -e

YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

echo ""
echo "${BLUE}╔══════════════════════════════════════╗${NC}"
echo "${BLUE}║        PRE-COMMIT CHECKS             ║${NC}"
echo "${BLUE}╚══════════════════════════════════════╝${NC}"
echo ""

echo "${YELLOW}[1/4] Checking for unresolved merge conflicts...${NC}"
CONFLICTS=$(git diff --name-only --diff-filter=U 2>/dev/null)
if [ -n "$CONFLICTS" ]; then
  echo "${RED}❌ Unresolved conflicts in:${NC}"
  echo "$CONFLICTS"
  exit 1
fi
echo "${GREEN}  ✓ No conflicts${NC}"

echo "${YELLOW}[2/4] Checking staged file sizes...${NC}"
MAX_FILE_SIZE_BYTES=1048576
OVERSIZED=$(git diff --cached --name-only -z --diff-filter=ACM | xargs -0 sh -c '
  for f do
    size=$(git cat-file -s ":$f")
    if [ "$size" -gt "$0" ]; then printf "%s (%s bytes)\n" "$f" "$size"; fi
  done
' "$MAX_FILE_SIZE_BYTES")
if [ -n "$OVERSIZED" ]; then
  echo "${RED}❌ File too large:${NC}"
  echo "$OVERSIZED"
  echo "   Landing pages must ship optimized assets. Use src/assets/ or public/ deliberately."
  exit 1
fi
echo "${GREEN}  ✓ No oversized staged files${NC}"

echo "${YELLOW}[3/4] Looking for conflict markers and debug statements...${NC}"
staged_source() {
  git diff --cached --name-only -z --diff-filter=ACM -- '*.astro' '*.css' '*.js' '*.jsx' '*.ts' '*.tsx' '*.md' '*.mdx'
}

CONFLICT_MARKERS=$(staged_source | xargs -0 grep -n -E '^(<<<<<<<|=======|>>>>>>>)' -- 2>/dev/null || true)
if [ -n "$CONFLICT_MARKERS" ]; then
  echo "${RED}❌ Conflict markers found:${NC}"
  echo "$CONFLICT_MARKERS"
  exit 1
fi

DEBUGS=$(staged_source | xargs -0 grep -n -E '^\s*(console\.(log|debug)|debugger)' -- 2>/dev/null || true)
if [ -n "$DEBUGS" ]; then
  echo "${RED}❌ console.log/debugger found:${NC}"
  echo "$DEBUGS"
  echo ""
  echo "   Use intentional logging or remove the debug statement before committing."
  exit 1
fi
echo "${GREEN}  ✓ No conflict markers or stray debug statements${NC}"

echo "${YELLOW}[4/4] Formatting and linting staged files...${NC}"
pnpm exec lint-staged
echo "${GREEN}  ✓ Format and lint OK${NC}"

echo ""
echo "${GREEN}✅ Pre-commit checks passed!${NC}"
echo "${BLUE}  ℹ Typecheck, tests, and build run in pre-push.${NC}"
echo ""
