---
import './checkbox.css'

interface Props {
  label?: string
  class?: string
}

const { label, class: className } = Astro.props
const classes = ['checkbox-group', className].filter(Boolean).join(' ')
---

<fieldset class={classes}>
  {label !== undefined && label !== '' && <legend class="checkbox-group-legend">{label}</legend>}
  <div class="checkbox-group-items">
    <slot />
  </div>
</fieldset>
