---
import Contact from '@components/sections/Contact/Contact.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="contact" title={t.nav.contact} description={t.descriptions.contact}>
  <Text as="h3" class="mt-8">
    Default
  </Text>
  <div class="mt-3 neu-frame p-6">
    <Contact
      title="Get in touch"
      description="Fill out the form below and we'll get back to you shortly."
    />
  </div>

  <Text as="h3" class="mt-8">
    With subject field
  </Text>
  <div class="mt-3 neu-frame p-6">
    <Contact
      title="Support request"
      description="Tell us what you need help with."
      showSubject
      submitLabel="Submit request"
    />
  </div>
</ShowcasePanel>
