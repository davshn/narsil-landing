---
import Accordion from '@components/ui/Accordion/Accordion.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="accordion" title={t.nav.accordion} description={t.descriptions.accordion}>
  <Text as="h3" class="mt-8">
    Single open (default)
  </Text>
  <div class="mt-3 max-w-lg">
    <Accordion
      items={[
        {
          label: 'What is this template?',
          content:
            'A reusable Astro landing page template with a full design system, i18n, SEO, and accessibility built in.',
        },
        {
          label: 'Is it free?',
          content:
            'Yes, completely open source and free to use for personal and commercial projects.',
        },
        {
          label: 'Can I customize the theme?',
          content:
            'Absolutely. All visual tokens live in global.css and theme.ts. Change once, update everywhere.',
          open: true,
        },
      ]}
    />
  </div>

  <Text as="h3" class="mt-8">
    Multiple open
  </Text>
  <div class="mt-3 max-w-lg">
    <Accordion
      multiple
      items={[
        {
          label: 'First item',
          content: 'This accordion allows multiple items to be open simultaneously.',
          open: true,
        },
        {
          label: 'Second item',
          content: 'Click any item to toggle it independently of the others.',
          open: true,
        },
        {
          label: 'Third item',
          content: 'Useful for FAQ sections where users want to compare answers.',
        },
      ]}
    />
  </div>

  <Text as="h3" class="mt-8">
    All closed
  </Text>
  <div class="mt-3 max-w-lg">
    <Accordion
      items={[
        {
          label: 'How do I deploy?',
          content: 'Run pnpm build and deploy the dist/ folder to any static hosting provider.',
        },
        {
          label: 'Does it support dark mode?',
          content:
            'Yes, class-based dark mode with localStorage persistence and system preference fallback.',
        },
      ]}
    />
  </div>
</ShowcasePanel>
