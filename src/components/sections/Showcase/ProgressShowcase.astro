---
import Progress from '@components/ui/Progress/Progress.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="progress" title={t.nav.progress} description={t.descriptions.progress}>
  <Text as="h3" class="mt-8">
    Colors
  </Text>
  <div class="mt-3 flex flex-col gap-4">
    <Progress value={70} color="primary" />
    <Progress value={50} color="accent" />
    <Progress value={90} color="success" />
    <Progress value={40} color="warning" />
    <Progress value={25} color="destructive" />
  </div>

  <Text as="h3" class="mt-8">
    Sizes
  </Text>
  <div class="mt-3 flex flex-col gap-4">
    <Progress value={60} size="sm" />
    <Progress value={60} size="md" />
    <Progress value={60} size="lg" />
  </div>

  <Text as="h3" class="mt-8">
    With value label
  </Text>
  <div class="mt-3 flex flex-col gap-4">
    <Progress value={33} max={100} showValue />
    <Progress value={7} max={10} showValue color="success" />
    <Progress value={150} max={200} showValue color="accent" />
  </div>

  <Text as="h3" class="mt-8">
    Direction RTL
  </Text>
  <div class="mt-3 flex flex-col gap-4">
    <Progress value={65} direction="rtl" color="primary" />
    <Progress value={45} direction="rtl" color="warning" showValue />
  </div>

  <Text as="h3" class="mt-8">
    Vertical
  </Text>
  <div class="mt-3 flex items-end gap-6 h-32">
    <Progress value={80} orientation="vertical" color="primary" size="md" />
    <Progress value={50} orientation="vertical" color="success" size="md" />
    <Progress value={30} orientation="vertical" color="warning" size="lg" />
    <Progress value={60} orientation="vertical" color="accent" size="sm" />
  </div>
</ShowcasePanel>
