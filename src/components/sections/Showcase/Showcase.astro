---
import ResponsiveImage from '@components/ui/ResponsiveImage/ResponsiveImage.astro'

import './showcase.css'

type Frame = 'window' | 'pane' | 'phone'

interface ShowcaseShot {
  light: ImageMetadata | string
  dark: ImageMetadata | string
  alt: string
  width: number
  height: number
}

interface ShowcaseItem extends ShowcaseShot {
  title: string
  text: string
  frame: Frame
  detail?: ShowcaseShot
}

interface Props {
  title: string
  subtitle?: string
  items: ShowcaseItem[]
  note?: string
}

const { title, subtitle, items, note } = Astro.props
const sizes = '(min-width: 1024px) 22rem, 90vw'
---

<section class="showcase">
  <div class="showcase-inner section-shell">
    <div class="showcase-header">
      <h2 class="section-title">{title}</h2>
      {subtitle !== undefined && subtitle !== '' && <p class="section-description">{subtitle}</p>}
    </div>
    <div class="showcase-grid">
      {items.map((item) => (
        <figure class="showcase-item">
          <div
            class={`showcase-shots${item.detail === undefined ? '' : ' showcase-shots-detailed'}`}
          >
            {[
              { shot: item, className: `showcase-frame showcase-frame-${item.frame}` },
              ...(item.detail === undefined
                ? []
                : [{ shot: item.detail, className: 'showcase-detail' }]),
            ].map(({ shot, className }) => (
              <div class={className}>
                <ResponsiveImage
                  src={shot.light}
                  alt={shot.alt}
                  width={shot.width}
                  height={shot.height}
                  sizes={sizes}
                  pictureClass="theme-light-only"
                />
                <ResponsiveImage
                  src={shot.dark}
                  alt={shot.alt}
                  width={shot.width}
                  height={shot.height}
                  sizes={sizes}
                  pictureClass="theme-dark-only"
                />
              </div>
            ))}
          </div>
          <figcaption class="showcase-caption">
            <span class="showcase-caption-title">{item.title}</span>
            <span class="showcase-caption-text">{item.text}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    {note !== undefined && note !== '' && <p class="showcase-note">{note}</p>}
    <slot />
  </div>
</section>
