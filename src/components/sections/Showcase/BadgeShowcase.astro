---
import Badge from '@components/ui/Badge/Badge.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="badge" title={t.nav.badge} description={t.descriptions.badge}>
  <Text as="h3" class="mt-8">
    Soft (default)
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <Badge color="default">Default</Badge>
    <Badge color="primary">Primary</Badge>
    <Badge color="secondary">Secondary</Badge>
    <Badge color="accent">Accent</Badge>
    <Badge color="success">Success</Badge>
    <Badge color="warning">Warning</Badge>
    <Badge color="destructive">Destructive</Badge>
  </div>

  <Text as="h3" class="mt-8">
    Outline
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <Badge variant="outline" color="default">
      Default
    </Badge>
    <Badge variant="outline" color="primary">
      Primary
    </Badge>
    <Badge variant="outline" color="accent">
      Accent
    </Badge>
    <Badge variant="outline" color="success">
      Success
    </Badge>
    <Badge variant="outline" color="warning">
      Warning
    </Badge>
    <Badge variant="outline" color="destructive">
      Destructive
    </Badge>
  </div>

  <Text as="h3" class="mt-8">
    Solid
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <Badge variant="solid" color="default">
      Default
    </Badge>
    <Badge variant="solid" color="primary">
      Primary
    </Badge>
    <Badge variant="solid" color="accent">
      Accent
    </Badge>
    <Badge variant="solid" color="success">
      Success
    </Badge>
    <Badge variant="solid" color="warning">
      Warning
    </Badge>
    <Badge variant="solid" color="destructive">
      Destructive
    </Badge>
  </div>

  <Text as="h3" class="mt-8">
    Sizes
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <Badge size="sm" color="primary">
      Small
    </Badge>
    <Badge size="md" color="primary">
      Medium
    </Badge>
    <Badge size="lg" color="primary">
      Large
    </Badge>
  </div>

  <Text as="h3" class="mt-8">
    With icon
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <Badge color="success" icon="lucide:check">
      Verified
    </Badge>
    <Badge color="warning" icon="lucide:clock">
      Pending
    </Badge>
    <Badge color="destructive" icon="lucide:x">
      Rejected
    </Badge>
    <Badge variant="outline" color="primary" icon="lucide:star">
      Featured
    </Badge>
    <Badge variant="solid" color="accent" icon="lucide:zap" size="lg">
      Pro
    </Badge>
  </div>
</ShowcasePanel>
