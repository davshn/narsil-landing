---
import Footer from '@components/sections/Footer/Footer.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props

const groups = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '#footer' },
      { label: 'Pricing', href: '#footer' },
      { label: 'Changelog', href: '#footer' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '#footer' },
      { label: 'Blog', href: '#footer' },
      { label: 'Careers', href: '#footer' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '#footer' },
      { label: 'Terms', href: '#footer' },
    ],
  },
]

const social = [
  { icon: 'lucide:github', href: '#footer', label: 'GitHub' },
  { icon: 'lucide:twitter', href: '#footer', label: 'Twitter' },
  { icon: 'lucide:linkedin', href: '#footer', label: 'LinkedIn' },
]
---

<ShowcasePanel id="footer" title={t.nav.footer} description={t.descriptions.footer}>
  <Text as="h3" class="mt-8">
    Full footer
  </Text>
  <div class="mt-3 neu-frame overflow-hidden">
    <Footer
      brand="Acme Inc"
      description="Building better products for everyone."
      groups={groups}
      social={social}
    />
  </div>

  <Text as="h3" class="mt-8">
    Minimal (brand + copyright only)
  </Text>
  <div class="mt-3 neu-frame overflow-hidden">
    <Footer brand="MyApp" />
  </div>

  <Text as="h3" class="mt-8">
    With bottom slot
  </Text>
  <div class="mt-3 neu-frame overflow-hidden">
    <Footer brand="Studio" description="Creative agency." social={social}>
      <nav class="flex gap-4 text-xs text-muted-foreground">
        <a href="#footer" class="hover:text-foreground">
          Privacy
        </a>
        <a href="#footer" class="hover:text-foreground">
          Terms
        </a>
        <a href="#footer" class="hover:text-foreground">
          Cookies
        </a>
      </nav>
    </Footer>
  </div>
</ShowcasePanel>
