---
import Text from '@components/ui/Text/Text.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="text" title={t.nav.text} description={t.descriptions.text}>
  <Text as="h3" class="mt-8">
    Headings
  </Text>
  <div class="mt-3 flex flex-col gap-2">
    <Text as="p" size="4xl" weight="bold">
      Heading 1
    </Text>
    <Text as="p" size="3xl" weight="bold">
      Heading 2
    </Text>
    <Text as="p" size="2xl" weight="semibold">
      Heading 3
    </Text>
    <Text as="p" size="xl" weight="semibold">
      Heading 4
    </Text>
    <Text as="p" size="lg" weight="medium">
      Heading 5
    </Text>
    <Text as="p" size="base" weight="medium">
      Heading 6
    </Text>
  </div>

  <Text as="h3" class="mt-8">
    Tones
  </Text>
  <div class="mt-3 flex flex-col gap-2">
    <Text as="p" tone="default">
      Default tone
    </Text>
    <Text as="p" tone="muted">
      Muted tone
    </Text>
    <Text as="p" tone="primary">
      Primary tone
    </Text>
    <Text as="p" tone="secondary">
      Secondary tone
    </Text>
    <Text as="p" tone="accent">
      Accent tone
    </Text>
    <Text as="p" tone="destructive">
      Destructive tone
    </Text>
    <Text as="p" tone="success">
      Success tone
    </Text>
    <Text as="p" tone="warning">
      Warning tone
    </Text>
  </div>

  <Text as="h3" class="mt-8">
    Weights
  </Text>
  <div class="mt-3 flex flex-col gap-2">
    <Text as="p" weight="regular">
      Regular weight
    </Text>
    <Text as="p" weight="medium">
      Medium weight
    </Text>
    <Text as="p" weight="semibold">
      Semibold weight
    </Text>
    <Text as="p" weight="bold">
      Bold weight
    </Text>
  </div>

  <Text as="h3" class="mt-8">
    Sizes
  </Text>
  <div class="mt-3 flex flex-col gap-2">
    <Text as="p" size="xs">
      Extra small (xs)
    </Text>
    <Text as="p" size="sm">
      Small (sm)
    </Text>
    <Text as="p" size="base">
      Base
    </Text>
    <Text as="p" size="lg">
      Large (lg)
    </Text>
    <Text as="p" size="xl">
      Extra large (xl)
    </Text>
    <Text as="p" size="2xl">
      2XL
    </Text>
    <Text as="p" size="3xl">
      3XL
    </Text>
    <Text as="p" size="4xl">
      4XL
    </Text>
  </div>
</ShowcasePanel>
