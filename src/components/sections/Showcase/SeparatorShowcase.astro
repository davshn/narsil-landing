---
import Separator from '@components/ui/Separator/Separator.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="separator" title={t.nav.separator} description={t.descriptions.separator}>
  <Text as="h3" class="mt-8">
    Styles
  </Text>
  <div class="mt-3 flex flex-col gap-6">
    <Separator style="solid" />
    <Separator style="dashed" />
    <Separator style="dotted" />
  </div>

  <Text as="h3" class="mt-8">
    Sizes
  </Text>
  <div class="mt-3 flex flex-col gap-6">
    <Separator size="sm" />
    <Separator size="md" />
    <Separator size="lg" />
  </div>

  <Text as="h3" class="mt-8">
    Colors
  </Text>
  <div class="mt-3 flex flex-col gap-6">
    <Separator color="default" />
    <Separator color="muted" />
    <Separator color="primary" />
    <Separator color="accent" />
  </div>

  <Text as="h3" class="mt-8">
    With label
  </Text>
  <div class="mt-3 flex flex-col gap-6">
    <Separator label="or" />
    <Separator label="section" contentPosition="start" />
    <Separator label="end" contentPosition="end" style="dashed" />
  </div>

  <Text as="h3" class="mt-8">
    With icon
  </Text>
  <div class="mt-3 flex flex-col gap-6">
    <Separator icon="lucide:star" />
    <Separator icon="lucide:heart" color="primary" />
    <Separator icon="lucide:zap" label="Pro" contentPosition="center" />
  </div>

  <Text as="h3" class="mt-8">
    Vertical
  </Text>
  <div class="mt-3 flex items-center gap-4 h-16">
    <span class="text-sm">Left</span>
    <Separator orientation="vertical" />
    <span class="text-sm">Center</span>
    <Separator orientation="vertical" style="dashed" color="primary" />
    <span class="text-sm">Right</span>
    <Separator orientation="vertical" size="lg" color="accent" />
    <span class="text-sm">End</span>
  </div>
</ShowcasePanel>
