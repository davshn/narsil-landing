---
import Hero from '@components/sections/Hero/Hero.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="hero" title={t.nav.hero} description={t.descriptions.hero}>
  <Text as="h3" class="mt-8">
    Centered (default)
  </Text>
  <div class="mt-3 neu-frame overflow-hidden">
    <Hero
      headline="Build landing pages faster"
      subheadline="A component system designed for speed, accessibility, and conversion."
      badge="New release"
      headingLevel="h3"
      actions={[
        { label: 'Get started', variant: 'primary' },
        { label: 'Learn more', variant: 'ghost' },
      ]}
    />
  </div>

  <Text as="h3" class="mt-8">
    Left aligned
  </Text>
  <div class="mt-3 neu-frame overflow-hidden">
    <Hero
      layout="left"
      headline="Ship your next idea"
      subheadline="Everything you need to go from concept to production."
      headingLevel="h3"
      actions={[{ label: 'Start free trial', variant: 'primary', href: '#hero' }]}
    />
  </div>

  <Text as="h3" class="mt-8">
    Split (with image)
  </Text>
  <div class="mt-3 neu-frame overflow-hidden">
    <Hero
      layout="split"
      headline="Design meets engineering"
      subheadline="A template where every component follows your design tokens."
      badge="Open source"
      headingLevel="h3"
      image={{
        src: 'https://placehold.co/600x400/e2e8f0/64748b?text=Product+Preview',
        alt: 'Product preview',
      }}
      actions={[
        { label: 'Get started', variant: 'primary', href: '#hero' },
        { label: 'View on GitHub', variant: 'outline', href: '#hero' },
      ]}
    />
  </div>
</ShowcasePanel>
