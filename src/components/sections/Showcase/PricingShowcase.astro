---
import Pricing from '@components/sections/Pricing/Pricing.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props

const plans = [
  {
    name: 'Free',
    description: 'For individuals getting started.',
    price: '$0',
    period: 'mo',
    cta: 'Get started',
    ctaHref: '#pricing',
    features: [
      { label: '1 project' },
      { label: '100 MB storage' },
      { label: 'Community support' },
      { label: 'Custom domain', included: false },
      { label: 'Analytics', included: false },
    ],
  },
  {
    name: 'Pro',
    description: 'For growing teams.',
    price: '$29',
    period: 'mo',
    cta: 'Start free trial',
    ctaHref: '#pricing',
    highlighted: true,
    badge: 'Popular',
    features: [
      { label: 'Unlimited projects' },
      { label: '10 GB storage' },
      { label: 'Priority support' },
      { label: 'Custom domain' },
      { label: 'Analytics', included: false },
    ],
  },
  {
    name: 'Enterprise',
    description: 'For large organizations.',
    price: '$99',
    period: 'mo',
    cta: 'Contact sales',
    ctaHref: '#pricing',
    features: [
      { label: 'Unlimited projects' },
      { label: 'Unlimited storage' },
      { label: 'Dedicated support' },
      { label: 'Custom domain' },
      { label: 'Advanced analytics' },
    ],
  },
]
---

<ShowcasePanel id="pricing" title={t.nav.pricing} description={t.descriptions.pricing}>
  <div class="mt-8">
    <Pricing plans={plans} />
  </div>
</ShowcasePanel>
