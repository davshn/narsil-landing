---
import Features from '@components/sections/Features/Features.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props

const demoFeatures = [
  {
    title: 'Fast by default',
    description: 'Built on Astro SSG for instant page loads.',
    icon: 'lucide:zap',
  },
  {
    title: 'Accessible',
    description: 'ARIA, keyboard nav, and focus management built in.',
    icon: 'lucide:accessibility',
  },
  {
    title: 'Dark mode',
    description: 'System preference with manual toggle and persistence.',
    icon: 'lucide:moon',
  },
  {
    title: 'SEO ready',
    description: 'JSON-LD, Open Graph, hreflang, and sitemap.',
    icon: 'lucide:search',
  },
  {
    title: 'i18n',
    description: 'Type-safe translations with locale-prefixed routing.',
    icon: 'lucide:globe',
  },
  {
    title: 'Design tokens',
    description: '15 token categories for consistent theming.',
    icon: 'lucide:palette',
  },
]
---

<ShowcasePanel id="features" title={t.nav.features} description={t.descriptions.features}>
  <Text as="h3" class="mt-8">
    3 columns (default)
  </Text>
  <div class="mt-3 neu-frame overflow-hidden">
    <Features
      title="Why this template?"
      subtitle="Everything you need to ship fast."
      features={demoFeatures}
    />
  </div>

  <Text as="h3" class="mt-8">
    2 columns
  </Text>
  <div class="mt-3 neu-frame overflow-hidden">
    <Features features={demoFeatures.slice(0, 4)} columns={2} />
  </div>

  <Text as="h3" class="mt-8">
    4 columns
  </Text>
  <div class="mt-3 neu-frame overflow-hidden">
    <Features
      features={demoFeatures.slice(0, 4).map((f) => ({ title: f.title, icon: f.icon }))}
      columns={4}
    />
  </div>

  <Text as="h3" class="mt-8">
    Without icons
  </Text>
  <div class="mt-3 neu-frame overflow-hidden">
    <Features
      title="Key benefits"
      features={[
        {
          title: 'No vendor lock-in',
          description: 'Deploy anywhere — Vercel, Netlify, Cloudflare.',
        },
        {
          title: 'Zero JS by default',
          description: 'Only ship JavaScript when you actually need it.',
        },
        { title: 'TypeScript strict', description: 'Full type safety across the entire codebase.' },
      ]}
    />
  </div>
</ShowcasePanel>
