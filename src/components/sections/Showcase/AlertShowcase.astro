---
import Alert from '@components/ui/Alert/Alert.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="alert" title={t.nav.alert} description={t.descriptions.alert}>
  <Text as="h3" class="mt-8">
    Variants
  </Text>
  <div class="mt-3 flex flex-col gap-3">
    <Alert variant="info" title="Information">
      This is an informational message.
    </Alert>
    <Alert variant="success" title="Success">
      Your changes have been saved.
    </Alert>
    <Alert variant="warning" title="Warning">
      This action cannot be undone easily.
    </Alert>
    <Alert variant="error" title="Error">
      Something went wrong. Please try again.
    </Alert>
  </div>

  <Text as="h3" class="mt-8">
    Without title
  </Text>
  <div class="mt-3 flex flex-col gap-3">
    <Alert variant="info">A simple info alert without a title.</Alert>
    <Alert variant="error">Connection lost. Check your network.</Alert>
  </div>

  <Text as="h3" class="mt-8">
    Custom icon
  </Text>
  <div class="mt-3 flex flex-col gap-3">
    <Alert variant="info" title="New update available" icon="lucide:rocket">
      Version 2.0 is ready to install.
    </Alert>
    <Alert variant="success" title="Payment received" icon="lucide:credit-card">
      Invoice #1234 has been paid.
    </Alert>
  </div>

  <Text as="h3" class="mt-8">
    Dismissible
  </Text>
  <div class="mt-3 flex flex-col gap-3">
    <Alert variant="info" title="Tip" dismissible>
      You can close this alert by clicking the X.
    </Alert>
    <Alert variant="warning" title="Session expiring" dismissible>
      Your session will expire in 5 minutes.
    </Alert>
  </div>

  <Text as="h3" class="mt-8">
    Auto-close (3 seconds)
  </Text>
  <div class="mt-3 flex flex-col gap-3">
    <Alert variant="success" title="Saved" dismissible autoClose={3000}>
      This alert will disappear in 3 seconds.
    </Alert>
  </div>
</ShowcasePanel>
