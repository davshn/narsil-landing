---
import Button from '@components/ui/Button/Button.astro'
import Modal from '@components/ui/Modal/Modal.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="modal" title={t.nav.modal} description={t.descriptions.modal}>
  <Text as="h3" class="mt-8">
    Sizes
  </Text>
  <div class="mt-3 flex flex-wrap gap-3">
    <Button variant="secondary" data-open-modal="demo-modal-sm">
      Small
    </Button>
    <Button variant="secondary" data-open-modal="demo-modal-md">
      Medium
    </Button>
    <Button variant="secondary" data-open-modal="demo-modal-lg">
      Large
    </Button>
    <Button variant="secondary" data-open-modal="demo-modal-xl">
      Extra Large
    </Button>
  </div>

  <Text as="h3" class="mt-8">
    With footer actions
  </Text>
  <div class="mt-3">
    <Button variant="primary" data-open-modal="demo-modal-actions">
      Open modal
    </Button>
  </div>

  <Text as="h3" class="mt-8">
    Custom close icon
  </Text>
  <div class="mt-3">
    <Button variant="ghost" data-open-modal="demo-modal-custom">
      Open modal
    </Button>
  </div>

  <Modal id="demo-modal-sm" title="Small modal" size="sm">
    <p>This is a small modal with limited width.</p>
  </Modal>

  <Modal id="demo-modal-md" title="Medium modal" size="md">
    <p>This is the default medium modal. Good for confirmations and short forms.</p>
  </Modal>

  <Modal id="demo-modal-lg" title="Large modal" size="lg">
    <p>A large modal for more complex content like multi-step forms or detailed information.</p>
  </Modal>

  <Modal id="demo-modal-xl" title="Extra large modal" size="xl">
    <p>Extra large modal for rich content, data tables, or full previews.</p>
  </Modal>

  <Modal id="demo-modal-actions" title="Confirm action">
    <p>Are you sure you want to proceed? This action cannot be undone.</p>
    <div slot="footer">
      <Button variant="ghost" size="sm" data-open-modal="demo-modal-actions">
        Cancel
      </Button>
      <Button variant="primary" size="sm">
        Confirm
      </Button>
    </div>
  </Modal>

  <Modal id="demo-modal-custom" title="Custom icon" closeIcon="lucide:arrow-left">
    <p>This modal uses a custom close icon (arrow-left instead of X).</p>
  </Modal>
</ShowcasePanel>

<script src="./modal-triggers.ts"></script>
