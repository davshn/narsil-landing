---
import Checkbox from '@components/ui/Checkbox/Checkbox.astro'
import CheckboxGroup from '@components/ui/Checkbox/CheckboxGroup.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="checkbox" title={t.nav.checkbox} description={t.descriptions.checkbox}>
  <Text as="h3" class="mt-8">
    Basic
  </Text>
  <div class="mt-3 flex flex-col gap-3">
    <Checkbox label="Accept terms and conditions" name="terms" />
    <Checkbox label="Remember me" name="remember" checked />
  </div>

  <Text as="h3" class="mt-8">
    Colors
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-4">
    <Checkbox label="Primary" color="primary" checked />
    <Checkbox label="Accent" color="accent" checked />
    <Checkbox label="Success" color="success" checked />
    <Checkbox label="Warning" color="warning" checked />
    <Checkbox label="Destructive" color="destructive" checked />
  </div>

  <Text as="h3" class="mt-8">
    Indeterminate
  </Text>
  <div class="mt-3 flex flex-col gap-3">
    <Checkbox label="Select all" name="select-all" indeterminate />
    <Checkbox label="Indeterminate accent" color="accent" indeterminate />
  </div>

  <Text as="h3" class="mt-8">
    Disabled
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-4">
    <Checkbox label="Disabled unchecked" disabled />
    <Checkbox label="Disabled checked" checked disabled />
  </div>

  <Text as="h3" class="mt-8">
    Group
  </Text>
  <div class="mt-3 max-w-sm">
    <CheckboxGroup label="Notifications">
      <Checkbox label="Email" name="notifications" value="email" checked />
      <Checkbox label="SMS" name="notifications" value="sms" />
      <Checkbox label="Push" name="notifications" value="push" checked />
    </CheckboxGroup>
  </div>

  <Text as="h3" class="mt-8">
    Without label
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-4">
    <Checkbox name="no-label-1" color="primary" ariaLabel="Unlabeled primary" />
    <Checkbox name="no-label-2" color="accent" checked ariaLabel="Unlabeled accent" />
    <Checkbox name="no-label-3" color="success" indeterminate ariaLabel="Unlabeled success" />
  </div>
</ShowcasePanel>
