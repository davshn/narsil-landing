---
import Select from '@components/ui/Select/Select.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="select" title={t.nav.select} description={t.descriptions.select}>
  <Text as="h3" class="mt-8">
    Single select
  </Text>
  <div class="mt-3 max-w-sm">
    <Select
      label="Country"
      name="demo-country"
      options={[
        { value: 'us', label: 'United States' },
        { value: 'mx', label: 'Mexico' },
        { value: 'co', label: 'Colombia' },
        { value: 'ar', label: 'Argentina' },
      ]}
      placeholder="Choose a country..."
    />
  </div>

  <Text as="h3" class="mt-8">
    Multi select + searchable
  </Text>
  <div class="mt-3 max-w-sm">
    <Select
      label="Frameworks"
      name="demo-frameworks"
      options={[
        { value: 'react', label: 'React' },
        { value: 'astro', label: 'Astro' },
        { value: 'vue', label: 'Vue' },
        { value: 'svelte', label: 'Svelte' },
        { value: 'solid', label: 'SolidJS' },
      ]}
      multiple
      searchable
      placeholder="Search..."
    />
  </div>

  <Text as="h3" class="mt-8">
    With error
  </Text>
  <div class="mt-3 max-w-sm">
    <Select
      label="Role"
      name="demo-role"
      options={[
        { value: 'admin', label: 'Admin' },
        { value: 'user', label: 'User' },
      ]}
      error="Please select a role"
      required
    />
  </div>

  <Text as="h3" class="mt-8">
    Disabled
  </Text>
  <div class="mt-3 max-w-sm">
    <Select
      label="Plan"
      name="demo-plan"
      options={[
        { value: 'free', label: 'Free' },
        { value: 'pro', label: 'Pro' },
      ]}
      value="free"
      disabled
    />
  </div>
</ShowcasePanel>
