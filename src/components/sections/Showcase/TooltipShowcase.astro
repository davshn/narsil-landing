---
import Button from '@components/ui/Button/Button.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'
import Tooltip from '@components/ui/Tooltip/Tooltip.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="tooltip" title={t.nav.tooltip} description={t.descriptions.tooltip}>
  <Text as="h3" class="mt-8">
    Positions
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-6">
    <Tooltip text="Top tooltip" position="top">
      <Button variant="secondary">Top</Button>
    </Tooltip>
    <Tooltip text="Bottom tooltip" position="bottom">
      <Button variant="secondary">Bottom</Button>
    </Tooltip>
    <Tooltip text="Left tooltip" position="left">
      <Button variant="secondary">Left</Button>
    </Tooltip>
    <Tooltip text="Right tooltip" position="right">
      <Button variant="secondary">Right</Button>
    </Tooltip>
  </div>

  <Text as="h3" class="mt-8">
    With keyboard shortcut
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-6">
    <Tooltip text="Copy" kbd="Ctrl+C">
      <Button variant="secondary">Copy</Button>
    </Tooltip>
    <Tooltip text="Paste" kbd="Ctrl+V">
      <Button variant="secondary">Paste</Button>
    </Tooltip>
    <Tooltip text="Save" kbd="Ctrl+S">
      <Button variant="secondary">Save</Button>
    </Tooltip>
    <Tooltip text="Search" kbd="Ctrl+K" position="bottom">
      <Button variant="secondary">Search</Button>
    </Tooltip>
  </div>

  <Text as="h3" class="mt-8">
    On other elements
  </Text>
  <div class="mt-3 flex flex-wrap items-center gap-6">
    <Tooltip text="Click to edit" position="top">
      <span class="text-sm underline decoration-dotted cursor-help text-foreground">Hover me</span>
    </Tooltip>
    <Tooltip text="Delete item" kbd="Del" position="right">
      <Button variant="icon" aria-label="Delete">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
      </Button>
    </Tooltip>
  </div>
</ShowcasePanel>
