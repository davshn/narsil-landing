---
import CTA from '@components/sections/CTA/CTA.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="cta" title={t.nav.cta} description={t.descriptions.cta}>
  <Text as="h3" class="mt-8">
    Default (centered)
  </Text>
  <div class="mt-3">
    <CTA
      headline="Ready to get started?"
      description="Join thousands of teams using our platform to build better products."
      actions={[
        { label: 'Start free trial', variant: 'primary' },
        { label: 'Talk to sales', variant: 'ghost' },
      ]}
    />
  </div>

  <Text as="h3" class="mt-8">
    Card variant
  </Text>
  <div class="mt-3">
    <CTA
      variant="card"
      headline="Upgrade to Pro"
      description="Get unlimited access to all features and priority support."
      actions={[{ label: 'Upgrade now', variant: 'primary', href: '#cta' }]}
    />
  </div>

  <Text as="h3" class="mt-8">
    Gradient variant
  </Text>
  <div class="mt-3">
    <CTA
      variant="gradient"
      headline="Build something amazing"
      description="Start your next project with our template and ship faster."
      actions={[
        { label: 'Get started', variant: 'primary', href: '#cta' },
        { label: 'View docs', variant: 'outline', href: '#cta' },
      ]}
    />
  </div>

  <Text as="h3" class="mt-8">
    Left aligned
  </Text>
  <div class="mt-3">
    <CTA
      align="left"
      variant="card"
      headline="Need help?"
      description="Our team is ready to answer your questions."
      actions={[{ label: 'Contact us', variant: 'primary', href: '#cta' }]}
    />
  </div>
</ShowcasePanel>
