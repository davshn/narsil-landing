---
import Carousel from '@components/sections/Carousel/Carousel.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props

const slides = [
  { bg: 'bg-primary/10', label: 'Slide 1' },
  { bg: 'bg-accent/10', label: 'Slide 2' },
  { bg: 'bg-success/10', label: 'Slide 3' },
  { bg: 'bg-warning/10', label: 'Slide 4' },
]
---

<ShowcasePanel id="carousel" title={t.nav.carousel} description={t.descriptions.carousel}>
  <Text as="h3" class="mt-8">
    Basic
  </Text>
  <div class="mt-3">
    <Carousel label="Default carousel demo">
      {slides.map((s) => (
        <div class={`flex items-center justify-center h-48 rounded-lg ${s.bg}`}>
          <Text as="p" size="xl" weight="semibold">
            {s.label}
          </Text>
        </div>
      ))}
    </Carousel>
  </div>

  <Text as="h3" class="mt-8">
    Autoplay (3s) + loop
  </Text>
  <div class="mt-3">
    <Carousel label="Autoplay carousel demo" autoplay={3000} loop>
      {slides.map((s) => (
        <div class={`flex items-center justify-center h-48 rounded-lg ${s.bg}`}>
          <Text as="p" size="xl" weight="semibold">
            {s.label}
          </Text>
        </div>
      ))}
    </Carousel>
  </div>

  <Text as="h3" class="mt-8">
    Without arrows
  </Text>
  <div class="mt-3">
    <Carousel label="Dots only carousel demo" showArrows={false} loop>
      {slides.map((s) => (
        <div class={`flex items-center justify-center h-48 rounded-lg ${s.bg}`}>
          <Text as="p" size="xl" weight="semibold">
            {s.label}
          </Text>
        </div>
      ))}
    </Carousel>
  </div>

  <Text as="h3" class="mt-8">
    Without dots
  </Text>
  <div class="mt-3">
    <Carousel label="Arrows only carousel demo" showDots={false}>
      {slides.map((s) => (
        <div class={`flex items-center justify-center h-48 rounded-lg ${s.bg}`}>
          <Text as="p" size="xl" weight="semibold">
            {s.label}
          </Text>
        </div>
      ))}
    </Carousel>
  </div>
</ShowcasePanel>
