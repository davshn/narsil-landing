---
import Badge from '@components/ui/Badge/Badge.astro'
import Button from '@components/ui/Button/Button.astro'
import Card from '@components/ui/Card/Card.astro'
import CardBody from '@components/ui/Card/CardBody.astro'
import CardFooter from '@components/ui/Card/CardFooter.astro'
import CardHeader from '@components/ui/Card/CardHeader.astro'
import CardImage from '@components/ui/Card/CardImage.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="card" title={t.nav.card} description={t.descriptions.card}>
  <Text as="h3" class="mt-8">
    Variants
  </Text>
  <div class="mt-3 grid gap-4 sm:grid-cols-2">
    <Card>
      <CardHeader>
        <p class="card-title">Default</p>
        <p class="card-description">Border + background</p>
      </CardHeader>
      <CardBody>Standard card with border.</CardBody>
    </Card>
    <Card variant="elevated">
      <CardHeader>
        <p class="card-title">Elevated</p>
        <p class="card-description">Shadow + no border</p>
      </CardHeader>
      <CardBody>Raised with shadow.</CardBody>
    </Card>
    <Card variant="outlined">
      <CardHeader>
        <p class="card-title">Outlined</p>
        <p class="card-description">Border only, no shadow</p>
      </CardHeader>
      <CardBody>Clean outline style.</CardBody>
    </Card>
    <Card variant="ghost">
      <CardHeader>
        <p class="card-title">Ghost</p>
        <p class="card-description">No border, no background</p>
      </CardHeader>
      <CardBody>Minimal container.</CardBody>
    </Card>
  </div>

  <Text as="h3" class="mt-8">
    With image
  </Text>
  <div class="mt-3 grid gap-4 sm:grid-cols-2">
    <Card>
      <CardImage
        src="https://placehold.co/400x200/e2e8f0/64748b?text=Feature"
        alt="Feature image"
      />
      <CardHeader>
        <p class="card-title">Feature Card</p>
        <p class="card-description">With top image and footer actions.</p>
      </CardHeader>
      <CardBody>Detailed description of this feature goes here.</CardBody>
      <CardFooter>
        <Button variant="primary" size="sm">
          Learn more
        </Button>
        <Button variant="ghost" size="sm">
          Dismiss
        </Button>
      </CardFooter>
    </Card>
    <Card variant="elevated">
      <CardImage src="https://placehold.co/400x200/dbeafe/3b82f6?text=Pro" alt="Pro plan" />
      <CardHeader>
        <div class="flex items-center gap-2">
          <p class="card-title">Pro Plan</p>
          <Badge color="primary" size="sm">
            Popular
          </Badge>
        </div>
        <p class="card-description">$29/month</p>
      </CardHeader>
      <CardBody>Everything in Free plus advanced features.</CardBody>
      <CardFooter>
        <Button variant="primary" size="sm">
          Subscribe
        </Button>
      </CardFooter>
    </Card>
  </div>

  <Text as="h3" class="mt-8">
    Interactive (link)
  </Text>
  <div class="mt-3 grid gap-4 sm:grid-cols-3">
    <Card interactive href="#card">
      <CardBody>
        <p class="card-title">Clickable card</p>
        <p class="card-description mt-1">Hover to see the effect.</p>
      </CardBody>
    </Card>
    <Card interactive href="#card" variant="elevated">
      <CardBody>
        <p class="card-title">Elevated link</p>
        <p class="card-description mt-1">With shadow on hover.</p>
      </CardBody>
    </Card>
    <Card interactive>
      <CardBody>
        <p class="card-title">Interactive div</p>
        <p class="card-description mt-1">Focusable without href.</p>
      </CardBody>
    </Card>
  </div>

  <Text as="h3" class="mt-8">
    Sizes
  </Text>
  <div class="mt-3 grid gap-4 sm:grid-cols-3">
    <Card size="sm">
      <CardHeader>
        <p class="card-title">Small</p>
      </CardHeader>
      <CardBody>Compact padding.</CardBody>
    </Card>
    <Card size="md">
      <CardHeader>
        <p class="card-title">Medium</p>
      </CardHeader>
      <CardBody>Default padding.</CardBody>
    </Card>
    <Card size="lg">
      <CardHeader>
        <p class="card-title">Large</p>
      </CardHeader>
      <CardBody>Generous padding.</CardBody>
    </Card>
  </div>
</ShowcasePanel>
