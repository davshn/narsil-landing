---
import Container from '@components/ui/Container/Container.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="container" title={t.nav.container} description={t.descriptions.container}>
  <Text as="h3" class="mt-8">
    Max widths
  </Text>
  <div class="mt-3 flex flex-col gap-3">
    <Container maxWidth="xs" padding="sm" class="bg-muted rounded-md">
      <Text as="p" size="sm">
        xs (512px)
      </Text>
    </Container>
    <Container maxWidth="sm" padding="sm" class="bg-muted rounded-md">
      <Text as="p" size="sm">
        sm (640px)
      </Text>
    </Container>
    <Container maxWidth="md" padding="sm" class="bg-muted rounded-md">
      <Text as="p" size="sm">
        md (768px)
      </Text>
    </Container>
    <Container maxWidth="lg" padding="sm" class="bg-muted rounded-md">
      <Text as="p" size="sm">
        lg (1024px)
      </Text>
    </Container>
    <Container maxWidth="xl" padding="sm" class="bg-muted rounded-md">
      <Text as="p" size="sm">
        xl (1280px)
      </Text>
    </Container>
    <Container maxWidth="full" padding="sm" class="bg-muted rounded-md">
      <Text as="p" size="sm">
        full (100%)
      </Text>
    </Container>
  </div>
</ShowcasePanel>
