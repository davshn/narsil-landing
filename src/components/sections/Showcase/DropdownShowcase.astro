---
import Button from '@components/ui/Button/Button.astro'
import Dropdown from '@components/ui/Dropdown/Dropdown.astro'
import ShowcasePanel from '@components/sections/Showcase/ShowcasePanel.astro'
import Text from '@components/ui/Text/Text.astro'

import type { TranslationShape } from '@i18n/index'

interface Props {
  t: TranslationShape
}

const { t } = Astro.props
---

<ShowcasePanel id="dropdown" title={t.nav.dropdown} description={t.descriptions.dropdown}>
  <Text as="h3" class="mt-8">
    Simple
  </Text>
  <div class="mt-3">
    <Dropdown
      id="demo-dropdown-simple"
      items={[
        { label: 'Edit', icon: 'lucide:pencil' },
        { label: 'Duplicate', icon: 'lucide:copy' },
        { label: 'Delete', icon: 'lucide:trash-2', variant: 'destructive' },
      ]}
    >
      <Button variant="secondary">Actions</Button>
    </Dropdown>
  </div>

  <Text as="h3" class="mt-8">
    With sections
  </Text>
  <div class="mt-3">
    <Dropdown
      id="demo-dropdown-sections"
      sections={[
        {
          label: 'Account',
          items: [
            { label: 'Profile', icon: 'lucide:user', href: '#dropdown' },
            { label: 'Settings', icon: 'lucide:settings', href: '#dropdown' },
          ],
        },
        {
          items: [{ label: 'Logout', icon: 'lucide:log-out', variant: 'destructive' }],
        },
      ]}
    >
      <Button variant="ghost">Account menu</Button>
    </Dropdown>
  </div>

  <Text as="h3" class="mt-8">
    Align end
  </Text>
  <div class="mt-3 flex justify-end">
    <Dropdown
      id="demo-dropdown-end"
      align="end"
      items={[
        { label: 'Option A', icon: 'lucide:circle' },
        { label: 'Option B', icon: 'lucide:circle' },
        { label: 'Disabled', icon: 'lucide:circle', disabled: true },
      ]}
    >
      <Button variant="icon" aria-label="More options">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="5" r="1"></circle>
          <circle cx="12" cy="12" r="1"></circle>
          <circle cx="12" cy="19" r="1"></circle>
        </svg>
      </Button>
    </Dropdown>
  </div>
</ShowcasePanel>
