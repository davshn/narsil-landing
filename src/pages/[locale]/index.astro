---
import Features from '@components/sections/Features/Features.astro'
import Hero from '@components/sections/Hero/Hero.astro'
import NarsilStates from '@components/sections/NarsilStates/NarsilStates.astro'
import Showcase from '@components/sections/Showcase/Showcase.astro'
import Badge from '@components/ui/Badge/Badge.astro'
import Button from '@components/ui/Button/Button.astro'
import Card from '@components/ui/Card/Card.astro'
import CardBody from '@components/ui/Card/CardBody.astro'
import Container from '@components/ui/Container/Container.astro'
import NarsilSprite from '@components/ui/NarsilSprite/NarsilSprite.astro'
import Text from '@components/ui/Text/Text.astro'
import { defaultLocale, isLocale, locales, type Locale } from '@i18n/index'
import { useTranslations } from '@i18n/utils'
import SiteLayout from '@layouts/SiteLayout.astro'
import { buildWebPage, buildWebSite } from '@seo/json-ld'
import { donationLink, resolveDonationUrl } from '@utils/donation'
import { routeHref } from '@utils/guides'

import checkDark from '../../assets/screens/check-oscuro.png'
import checkLight from '../../assets/screens/check-claro.png'
import overlayDark from '../../assets/screens/overlay-oscuro.png'
import overlayLight from '../../assets/screens/overlay-claro.png'
import narsilClaude from '../../assets/screens/narsil-claude.png'

export function getStaticPaths(): Array<{ params: { locale: Locale } }> {
  return locales.map((locale) => ({ params: { locale } }))
}

const rawLocale = Astro.params.locale ?? ''
const locale: Locale = isLocale(rawLocale) ? rawLocale : defaultLocale
const t = useTranslations(locale)
const donation = donationLink(resolveDonationUrl(import.meta.env.PUBLIC_DONATION_URL))

const [working, waiting, done, failed] = t.home.states.items
const [overlayCopy, checkCopy, claudeCopy] = t.home.showcase.items

const siteUrl = Astro.site?.href ?? Astro.url.origin
const pageUrl = new URL(Astro.url.pathname, siteUrl).href
const jsonLd = [
  buildWebSite({
    name: t.meta.siteName,
    url: siteUrl,
    description: t.meta.description,
    inLanguage: locale,
  }),
  buildWebPage({
    name: t.meta.title,
    url: pageUrl,
    description: t.meta.description,
    isPartOf: { '@type': 'WebSite', name: t.meta.siteName, url: siteUrl },
    inLanguage: locale,
  }),
]
---

<SiteLayout title={t.meta.title} description={t.meta.description} locale={locale} jsonLd={jsonLd}>
  <Hero
    headline={t.home.headline}
    subheadline={t.home.subheadline}
    actions={[
      { label: t.home.fundamentalsCta, href: routeHref(locale, 'mods') },
      { label: t.home.cta, href: '#routes', variant: 'outline' },
    ]}
    layout="split"
  >
    <NarsilSprite slot="media" pose="hola" size="lg" alt={t.home.heroAlt} framed />
  </Hero>

  <Container as="section" maxWidth="md" padding="section">
    <h2 class="section-title mb-6">{t.home.aboutTitle}</h2>
    <div class="flex flex-col gap-4">
      {t.home.about.map((paragraph) => (
        <Text as="p">{paragraph}</Text>
      ))}
    </div>
  </Container>

  <NarsilStates
    title={t.home.states.title}
    subtitle={t.home.states.subtitle}
    states={[
      { pose: 'trabajando', tone: 'working', ...working },
      { pose: 'necesita', tone: 'waiting', ...waiting },
      { pose: 'terminado', tone: 'done', ...done },
      { pose: 'error', tone: 'error', ...failed },
    ]}
  />

  <Showcase
    title={t.home.showcase.title}
    subtitle={t.home.showcase.subtitle}
    note={t.home.showcase.note}
    items={[
      {
        ...overlayCopy,
        frame: 'window',
        light: overlayLight,
        dark: overlayDark,
        width: 300,
        height: 620,
      },
      { ...checkCopy, frame: 'pane', light: checkLight, dark: checkDark, width: 340, height: 842 },
      {
        ...claudeCopy,
        frame: 'phone',
        light: narsilClaude,
        dark: narsilClaude,
        width: 360,
        height: 754,
      },
    ]}
  />

  <div id="routes">
    <Features
      title={t.home.routesTitle}
      subtitle={t.home.routesSubtitle}
      features={t.home.routes.map((route, index) =>
        index === 0
          ? { ...route, href: routeHref(locale, 'pet') }
          : index === 1
            ? { ...route, href: routeHref(locale, 'check') }
            : route,
      )}
      columns={3}
    />
  </div>

  <Container as="section" maxWidth="md" padding="section">
    <Card variant="outlined">
      <CardBody class="flex flex-col items-start gap-3">
        <div data-extension class="contents">
          <Badge color="warning">{t.home.extension.badge}</Badge>
          <h2 class="text-2xl font-bold tracking-tight">{t.home.extension.title}</h2>
          <Text as="p">{t.home.extension.text}</Text>
          <Text as="p" size="sm" tone="muted">
            {t.home.extension.note}
          </Text>
        </div>
      </CardBody>
    </Card>
  </Container>

  {donation !== undefined && (
    <Container as="section" maxWidth="md" padding="section">
      <Card>
        <CardBody class="flex flex-col items-start gap-4">
          <h2 class="section-title">{t.home.coffeeTitle}</h2>
          <Text as="p">{t.home.coffeeText}</Text>
          <Button href={donation.url} target="_blank" rel="noopener" data-donate>
            {t.home.coffeeCta}
          </Button>
        </CardBody>
      </Card>
    </Container>
  )}
</SiteLayout>
