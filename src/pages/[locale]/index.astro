---
import Hero from '@components/sections/Hero/Hero.astro'
import NarsilStates from '@components/sections/NarsilStates/NarsilStates.astro'
import PathCards from '@components/sections/PathCards/PathCards.astro'
import Showcase from '@components/sections/Showcase/Showcase.astro'
import Badge from '@components/ui/Badge/Badge.astro'
import Button from '@components/ui/Button/Button.astro'
import Card from '@components/ui/Card/Card.astro'
import CardBody from '@components/ui/Card/CardBody.astro'
import Container from '@components/ui/Container/Container.astro'
import NarsilBubble from '@components/ui/NarsilBubble/NarsilBubble.astro'
import NarsilSprite from '@components/ui/NarsilSprite/NarsilSprite.astro'
import Text from '@components/ui/Text/Text.astro'
import { defaultLocale, isLocale, languageTags, locales, type Locale } from '@i18n/index'
import { useTranslations } from '@i18n/utils'
import SiteLayout from '@layouts/SiteLayout.astro'
import { buildWebPage, buildWebSite } from '@seo/json-ld'
import { guideRefs } from '@content/guide-pages'
import { guidesFor, routeHref } from '@utils/guides'
import { REPOSITORIES } from '@utils/repositories'
import { fillTemplate } from '@utils/template'

import checkDark from '../../assets/screens/check-oscuro.png'
import checkLight from '../../assets/screens/check-claro.png'
import overlayDark from '../../assets/screens/overlay-oscuro.png'
import overlayLight from '../../assets/screens/overlay-claro.png'
import narsilAndroidBandDark from '../../assets/screens/narsil-android-band-oscuro.png'
import narsilAndroidBandLight from '../../assets/screens/narsil-android-band-claro.png'
import narsilAndroidDark from '../../assets/screens/narsil-android-oscuro.png'
import narsilAndroidLight from '../../assets/screens/narsil-android-claro.png'
import narsilWatchDark from '../../assets/screens/narsil-watch-oscuro.png'
import narsilWatchLight from '../../assets/screens/narsil-watch-claro.png'

export function getStaticPaths(): Array<{ params: { locale: Locale } }> {
  return locales.map((locale) => ({ params: { locale } }))
}

const rawLocale = Astro.params.locale ?? ''
const locale: Locale = isLocale(rawLocale) ? rawLocale : defaultLocale
const t = useTranslations(locale)

const [working, waiting, done, failed] = t.home.states.items
const refs = await guideRefs()
const pathKeys = ['pet', 'check', 'bot', 'android', 'watch'] as const
const pathPoses = ['hola', 'trabajando', 'terminado', 'necesita', 'hola'] as const
const experimentalPaths = new Set<string>(['android', 'watch'])
const guideCount = (key: (typeof pathKeys)[number] | 'mods'): string | undefined => {
  const count = guidesFor(refs, locale, key).length
  return count > 0 ? fillTemplate(t.guide.guideCount, { count }) : undefined
}
const repoLink = (key: (typeof pathKeys)[number]): { href: string; label: string } | undefined => {
  if (key === 'bot') return undefined
  const href = REPOSITORIES[key]
  return { href, label: fillTemplate(t.home.repoCta, { repo: href.split('/').at(-1) ?? '' }) }
}
const paths = t.home.routes.map((route, index) => {
  const key = pathKeys[index]
  return {
    ...route,
    pose: pathPoses[index],
    href: routeHref(locale, key),
    meta: guideCount(key),
    detour: experimentalPaths.has(key) ? t.home.apps.badge : undefined,
    repo: repoLink(key),
  }
})
const start = {
  title: t.mods.title,
  description: t.home.guide.startText,
  href: routeHref(locale, 'mods'),
  meta: guideCount('mods'),
}
const apps = (['android', 'watch'] as const).map((key) => ({
  key,
  ...t.home.apps[key],
  href: routeHref(locale, key),
}))
const [overlayCopy, checkCopy, androidCopy, watchCopy] = t.home.showcase.items
const { detailAlt: androidBandAlt = '', ...androidMenuCopy } = androidCopy

const siteUrl = Astro.site?.href ?? Astro.url.origin
const pageUrl = new URL(Astro.url.pathname, siteUrl).href
const jsonLd = [
  buildWebSite({
    name: t.meta.siteName,
    url: siteUrl,
    description: t.meta.description,
    inLanguage: languageTags[locale],
  }),
  buildWebPage({
    name: t.meta.title,
    url: pageUrl,
    description: t.meta.description,
    isPartOf: { '@type': 'WebSite', name: t.meta.siteName, url: siteUrl },
    inLanguage: languageTags[locale],
  }),
]
---

<SiteLayout title={t.meta.title} description={t.meta.description} locale={locale} jsonLd={jsonLd}>
  <Hero
    headline={t.home.headline}
    subheadline={t.home.subheadline}
    actions={[
      { label: t.home.fundamentalsCta, href: routeHref(locale, 'mods') },
      { label: t.home.cta, href: '#routes', variant: 'outline' },
    ]}
    layout="split"
  >
    <div slot="media" class="home-greeting">
      <NarsilSprite pose="hola" size="xl" alt={t.home.heroAlt} loading="eager" />
      <div class="home-greeting-talk">
        <NarsilBubble tail="left">{t.home.guide.hello}</NarsilBubble>
        <p class="home-greeting-status">
          <span class="home-greeting-dot" aria-hidden="true"></span>
          <strong>{working.label}</strong>
          <span class="home-greeting-detail">{t.home.guide.statusDetail}</span>
        </p>
      </div>
    </div>
  </Hero>

  <PathCards
    id="routes"
    title={t.home.routesTitle}
    guide={t.home.guide.routes}
    start={start}
    paths={paths}
  />

  <NarsilStates
    introTitle={t.home.aboutTitle}
    intro={t.home.about}
    title={t.home.states.title}
    subtitle={t.home.states.subtitle}
    states={[
      { pose: 'trabajando', tone: 'working', ...working },
      { pose: 'necesita', tone: 'waiting', ...waiting },
      { pose: 'terminado', tone: 'done', ...done },
      { pose: 'error', tone: 'error', ...failed },
    ]}
  />

  <Showcase
    title={t.home.showcase.title}
    subtitle={t.home.showcase.subtitle}
    note={t.home.showcase.note}
    guide={t.home.guide.showcase}
    items={[
      {
        ...overlayCopy,
        frame: 'window',
        light: overlayLight,
        dark: overlayDark,
        width: 300,
        height: 620,
      },
      { ...checkCopy, frame: 'pane', light: checkLight, dark: checkDark, width: 340, height: 1100 },
      {
        ...androidMenuCopy,
        frame: 'phone',
        light: narsilAndroidLight,
        dark: narsilAndroidDark,
        width: 360,
        height: 754,
        detail: {
          light: narsilAndroidBandLight,
          dark: narsilAndroidBandDark,
          alt: androidBandAlt,
          width: 360,
          height: 120,
          lightHeight: 131,
        },
      },
      {
        ...watchCopy,
        frame: 'watch',
        light: narsilWatchLight,
        dark: narsilWatchDark,
        width: 480,
        height: 480,
      },
    ]}
  />

  <section class="home-apps" aria-labelledby="home-apps-title">
    <Card variant="outlined">
      <CardBody class="home-apps-body">
        <div data-apps class="home-apps-copy">
          <Badge color="warning">{t.home.apps.badge}</Badge>
          <h2 id="home-apps-title" class="text-2xl font-bold tracking-tight">
            {t.home.apps.title}
          </h2>
          <Text as="p">{t.home.apps.text}</Text>
        </div>
        <ul class="home-apps-grid">
          {apps.map((app) => (
            <li class="home-app" data-app={app.key}>
              <h3 class="text-xl font-semibold">{app.title}</h3>
              <Text as="p" class="home-app-text">
                {app.text}
              </Text>
              <Button href={app.href} variant="outline" data-app-guides>
                {app.cta}
              </Button>
            </li>
          ))}
        </ul>
        <Text as="p" size="sm" tone="muted">
          {t.home.apps.note}
        </Text>
      </CardBody>
    </Card>
  </section>
</SiteLayout>
