---
import BotArchitecture from '@components/guide/BotArchitecture/BotArchitecture.astro'
import GuideCurriculum from '@components/guide/GuideCurriculum/GuideCurriculum.astro'
import PathStages from '@components/guide/PathStages/PathStages.astro'
import Button from '@components/ui/Button/Button.astro'
import Text from '@components/ui/Text/Text.astro'
import { guideRefs } from '@content/guide-pages'
import { languageTags, type Locale, type PathKey } from '@i18n/index'
import { useTranslations } from '@i18n/utils'
import SiteLayout from '@layouts/SiteLayout.astro'
import { buildBreadcrumbList, buildWebPage } from '@seo/json-ld'
import { guideHref, guidesFor } from '@utils/guides'
import { botPartGuides, groupStages, PATH_STAGE_STARTS } from '@utils/path-stages'
import { readingDuration, readingMinutes } from '@utils/reading-time'
import { fillTemplate } from '@utils/template'

import './guide-index.css'

interface Props {
  locale: Locale
  route: PathKey
}

const { locale, route } = Astro.props
const t = useTranslations(locale)
const copy = t[route]
const guides = guidesFor(await guideRefs(), locale, route)
const [first] = guides

const minutesOf = guides.map((guide) => readingMinutes(guide.entry.body ?? ''))
const totalMinutes = minutesOf.reduce((sum, minutes) => sum + minutes, 0)
const total = readingDuration(totalMinutes)
const totalLabel = fillTemplate(
  total.unit === 'hours' ? t.guide.readingHours : t.guide.readingMinutes,
  { value: total.value },
)
const latest = guides.reduce<Date | undefined>((newest, guide) => {
  const { updated } = guide.entry.data
  return newest === undefined || updated > newest ? updated : newest
}, undefined)
const latestText =
  latest === undefined
    ? undefined
    : new Intl.DateTimeFormat(languageTags[locale], { dateStyle: 'long', timeZone: 'UTC' }).format(
        latest,
      )

const items = guides.map((guide, index) => ({
  title: guide.title,
  description: guide.entry.data.description,
  href: guideHref(locale, route, guide.slug),
  meta: fillTemplate(t.guide.guideMinutes, { value: minutesOf[index] }),
}))

const numbered = guides.map((guide, index) => ({
  slug: guide.slug,
  number: index + 1,
  title: guide.title,
  href: guideHref(locale, route, guide.slug),
}))
const stages = groupStages(numbered, PATH_STAGE_STARTS[route]).map((group, index) => ({
  title: copy.stages[index]?.title ?? '',
  text: copy.stages[index]?.text ?? '',
  guides: group,
}))

const siteUrl = Astro.site?.href ?? Astro.url.origin
const pageUrl = new URL(Astro.url.pathname, siteUrl).href
const jsonLd = [
  buildWebPage({
    name: copy.title,
    url: pageUrl,
    description: copy.description,
    isPartOf: { '@type': 'WebSite', name: t.meta.siteName, url: siteUrl },
    inLanguage: languageTags[locale],
  }),
  buildBreadcrumbList([
    { name: t.meta.siteName, url: new URL(`/${locale}/`, siteUrl).href },
    { name: copy.title, url: pageUrl },
  ]),
]
---

<SiteLayout
  title={`${copy.title} — ${t.meta.siteName}`}
  description={copy.description}
  locale={locale}
  jsonLd={jsonLd}
>
  <div class="path-page">
    <header class="path-hero">
      <div class="path-hero-text">
        <h1 class="path-title">{copy.title}</h1>
        {copy.intro.map((paragraph) => (
          <Text as="p" class="path-intro">
            {paragraph}
          </Text>
        ))}
        {first !== undefined && (
          <div>
            <Button size="lg" href={guideHref(locale, route, first.slug)}>
              {copy.startCta}
            </Button>
          </div>
        )}
      </div>
      {guides.length > 0 && (
        <aside class="path-summary" aria-labelledby="path-summary-title" data-path-summary>
          <h2 id="path-summary-title" class="path-summary-title">
            {t.guide.summaryTitle}
          </h2>
          <ul class="path-summary-list">
            <li class="path-summary-count">
              {fillTemplate(t.guide.guideCount, { count: guides.length })}
            </li>
            <li>{totalLabel}</li>
            {latestText !== undefined && <li>{`${t.guide.updated}: ${latestText}`}</li>}
          </ul>
        </aside>
      )}
    </header>

    <PathStages title={t.guide.stagesTitle} labelTemplate={t.guide.stageGuide} stages={stages} />

    {route === 'bot' && guides.length > 0 && (
      <BotArchitecture
        title={t.botMap.title}
        text={t.botMap.text}
        labelTemplate={t.guide.stageGuide}
        parts={t.botMap.parts}
        guides={botPartGuides(numbered)}
        links={t.botMap.links}
      />
    )}

    <section class="path-guides" aria-labelledby="guides-title">
      <h2 id="guides-title" class="path-section-title">
        {copy.listTitle}
      </h2>
      <GuideCurriculum items={items} />
    </section>
  </div>
</SiteLayout>
