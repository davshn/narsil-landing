---
import Footer from '@components/sections/Footer/Footer.astro'
import Header from '@components/sections/Header/Header.astro'
import LanguageSelector from '@components/sections/LanguageSelector/LanguageSelector.astro'
import Button from '@components/ui/Button/Button.astro'
import SkipToContent from '@components/ui/SkipToContent/SkipToContent.astro'
import ThemeToggle from '@components/ui/ThemeToggle/ThemeToggle.astro'
import type { Locale } from '@i18n/index'
import { useTranslations } from '@i18n/utils'
import BaseLayout from '@layouts/BaseLayout.astro'
import { copyrightNotice } from '@utils/developer'
import { donationLink, resolveDonationUrl } from '@utils/donation'

interface Props {
  title: string
  description: string
  locale: Locale
  jsonLd?: object | object[]
  og?: { image?: string; type?: 'website' | 'article'; modifiedTime?: string }
}

const { title, description, locale, jsonLd, og } = Astro.props
const t = useTranslations(locale)

const modsHref = `/${locale}/mods/`
const toolsHref = `/${locale}/tools/`
const links = [
  {
    label: t.nav.mods,
    href: modsHref,
    active: Astro.url.pathname.startsWith(modsHref),
  },
  { label: t.nav.routes, href: `/${locale}/#routes`, active: false },
  {
    label: t.nav.tools,
    href: toolsHref,
    active: Astro.url.pathname.startsWith(toolsHref),
  },
  {
    label: t.nav.support,
    href: `/${locale}/support/`,
    active: Astro.url.pathname === `/${locale}/support/`,
  },
]

const donation = donationLink(resolveDonationUrl(import.meta.env.PUBLIC_DONATION_URL))
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  siteName={t.meta.siteName}
  jsonLd={jsonLd}
  og={og}
>
  <SkipToContent slot="skip-nav" label={t.common.skipToContent} />

  <Header
    slot="header"
    brand={t.meta.siteName}
    brandHref={`/${locale}/`}
    navLabel={t.common.mainNavigation}
    links={links}
  >
    <LanguageSelector locale={locale} pathname={Astro.url.pathname} label={t.common.language} />
    <ThemeToggle slot="bar-actions" label={t.common.toggleTheme} />
    <LanguageSelector
      slot="mobile-actions"
      locale={locale}
      pathname={Astro.url.pathname}
      label={t.common.language}
      placement="inline"
    />
  </Header>

  <slot />

  <Footer
    slot="footer"
    brand={t.meta.siteName}
    description={`${t.footer.description} ${t.footer.privacy}`}
    copyright={copyrightNotice(new Date().getFullYear())}
    notes={[t.footer.trademark, t.footer.license]}
  >
    {donation !== undefined && (
      <Fragment slot="support">
        <p class="footer-support-text" data-footer-support>
          {t.footer.support}
        </p>
        <Button href={donation.url} target="_blank" rel="noopener" data-donate>
          {t.footer.donate}
        </Button>
      </Fragment>
    )}
  </Footer>
</BaseLayout>
