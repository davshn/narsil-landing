---
import InlineScript from '@components/layout/InlineScript.astro'
import AnalyticsProvider from '@components/layout/AnalyticsProvider.astro'
import { defaultLocale, languageTags, locales, ogLocales, type Locale } from '@i18n/index'
import '@styles/global.css'
import { buildAlternateUrl } from '@utils/alternate-url'
import { serializeForInlineScript } from '@utils/inline-json'

interface Props {
  title: string
  description: string
  locale?: Locale
  canonical?: string
  og?: {
    title?: string
    description?: string
    image?: string
  }
  jsonLd?: object | object[]
  siteName?: string
}

const {
  title,
  description,
  locale = defaultLocale,
  canonical,
  og,
  jsonLd,
  siteName = title,
} = Astro.props
const { title: customOgTitle, description: customOgDescription, image: ogImage } = og ?? {}

const ogTitle = customOgTitle ?? title
const ogDescription = customOgDescription ?? description
const canonicalUrl = canonical ?? Astro.url.href
const site = Astro.site
const defaultOgImage = site === undefined ? undefined : new URL('/og-image.png', site).href
const finalOgImage = ogImage ?? defaultOgImage
const hasOgImage = finalOgImage !== undefined && finalOgImage !== ''
const alternateOgLocales = locales.filter((loc) => loc !== locale).map((loc) => ogLocales[loc])
---

<html lang={languageTags[locale]} class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eef2f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#3f3f3f" media="(prefers-color-scheme: dark)" />

    <InlineScript
      code={`
      ;(function () {
        var stored = null
        try {
          stored = localStorage.getItem('theme')
        } catch (e) {}
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        var isDark = stored === 'dark' || (stored !== 'light' && prefersDark)
        document.documentElement.classList.toggle('dark', isDark)
      })()
    `}
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {site !== undefined &&
      locales.map((loc) => (
        <link
          rel="alternate"
          hreflang={languageTags[loc]}
          href={buildAlternateUrl(Astro.url.pathname, loc, site, locales)}
        />
      ))}
    {site !== undefined && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={buildAlternateUrl(Astro.url.pathname, defaultLocale, site, locales)}
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {alternateOgLocales.map((ogLocale) => (
      <meta property="og:locale:alternate" content={ogLocale} />
    ))}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {hasOgImage && (
      <>
        <meta property="og:image" content={finalOgImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogTitle} />
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {hasOgImage && (
      <>
        <meta name="twitter:image" content={finalOgImage} />
        <meta name="twitter:image:alt" content={ogTitle} />
      </>
    )}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {jsonLd !== undefined && (
      <script type="application/ld+json" set:html={serializeForInlineScript(jsonLd)} />
    )}

    <AnalyticsProvider />
  </head>
  <body>
    <slot name="skip-nav" />
    <slot name="header" />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
