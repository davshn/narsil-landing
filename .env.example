# Production site URL — enables canonical URLs, hreflang alternates, and the sitemap.
# Copy this file to .env and set the value before deploying.
PUBLIC_SITE_URL=https://example.com

# Analytics — set the variables for the providers you want to activate.
# Leave empty or remove to disable a provider. Multiple can be active simultaneously.

# Plausible Analytics (https://plausible.io)
PUBLIC_ANALYTICS_PLAUSIBLE_DOMAIN=

# Google Analytics 4
PUBLIC_ANALYTICS_GA_ID=

# Umami Analytics (https://umami.is)
PUBLIC_ANALYTICS_UMAMI_ID=
PUBLIC_ANALYTICS_UMAMI_SRC=

# PostHog (https://posthog.com)
PUBLIC_ANALYTICS_POSTHOG_KEY=
PUBLIC_ANALYTICS_POSTHOG_HOST=
