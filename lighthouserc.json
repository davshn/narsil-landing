{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/en/",
        "http://localhost/es/",
        "http://localhost/en/support/",
        "http://localhost/en/mods/",
        "http://localhost/en/mods/what-is-a-mod/",
        "http://localhost/en/mods/pet/states/",
        "http://localhost/en/mods/check/side-panel/",
        "http://localhost/en/bot/",
        "http://localhost/en/bot/claude-brain/",
        "http://localhost/en/tools/",
        "http://localhost/en/tools/priority/"
      ],
      "numberOfRuns": 5,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/reports"
    }
  }
}
